[Unit]
Description=MONAD screener snapshot refresh (read-only research; no broker, no orders)
After=network-online.target
Wants=network-online.target
# Never contend with the trader. This is research data collection: if it does not run,
# the /screener page renders a stale-but-labelled snapshot, which is a normal state it
# is designed for — nothing downstream breaks.
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=hudson
Group=hudson
WorkingDirectory=/home/hudson/MONAD-quant
Environment=PYTHONUNBUFFERED=1
# ProtectSystem=strict below makes the repo read-only, so a .pyc write would fail on
# every import. Python degrades gracefully, but silently — saying "don't" is clearer
# than relying on it to shrug.
Environment=PYTHONDONTWRITEBYTECODE=1

# ~0.4s per ticker for fundamentals, plus Reddit's own rate-limit pacing (the feeds
# report `x-ratelimit-reset` of 7-60s and the fetcher honours it, so four subreddits
# cost roughly two minutes of mostly-waiting). 250 names is a Pi-friendly balance;
# raise it toward 500 for the full index if the box has the time.
ExecStart=/home/hudson/MONAD-quant/venv/bin/python /home/hudson/MONAD-quant/tools/screener_lab.py refresh --limit 250

# The trader owns this machine. A research fetch must be invisible to it: lowest CPU
# priority, idle I/O class, and a hard ceiling so a hung vendor call cannot leave a
# python process resident into the next trading session.
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
TimeoutStartSec=1800

# Writes exactly one file — data/cache/screener_snapshot.json, which is gitignored, so
# an unattended refresh cannot dirty the working tree and trip the git-drift check.
# Never touches state.db, live/**, config.py, or the broker.
ProtectSystem=strict
ReadWritePaths=/home/hudson/MONAD-quant/data/cache
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=monad-screener
