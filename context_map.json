     "run": ["python sweep.py TICKER"], "avoid": ["live/ trader/order paths"]},
    {"keywords": ["objective", "live_score", "ev_score", "scoring", "sizing", "slippage", "cost", "spread", "fill model", "reproducib", "walk-forward", "walk forward", "optimizer", "selection", "overfit", "metrics", "sharpe", "leak-free", "oos", "out-of-sample", "edge", "validation", "research", "hypothesis", "idea", "findings", "web"],
