     "run": ["ctx web", "ctx map optimization", "venv/bin/python tools/walkforward_eval.py QQQ TQQQ --objective ev", "venv/bin/python tools/instrument_screen.py QQQ SPY TQQQ --stop 0.005", "python sweep.py TICKER --objective ev"],
     "avoid": ["trusting holdout-selected sweep numbers (selection-biased) — prefer the leak-free walkforward_eval", "changing the default sweep objective/sizing/selection without sign-off"]},
    {"keywords": ["trader", "live", "entry", "exit", "reconcile", "on_bar", "pending_close", "position"],
     "read": ["OPERATIONS.md", "live/trader.py::_on_bar_inner", "tests/test_trader_reconcile.py"],
     "run": ["bash ops/status_check.sh", "ctx status"], "avoid": ["strategy logic"]},
    {"keywords": ["ibkr", "broker", "order", "bracket", "fill", "gateway"],
