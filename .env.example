# IBKR — No API keys needed. Authenticate via TWS or IB Gateway GUI.
# Ensure TWS/Gateway is running on localhost:
#   Paper trading: port 7497 (default)
#   Live trading:  port 7496

# Optional — only needed for BTC Daily mode (not required for ETF live trading)
ALPHA_VANTAGE_KEY=optional

# Slack alerts — sends entry/exit/error notifications to a Slack channel.
# Create at: https://api.slack.com/apps → Incoming Webhooks
# Leave blank to disable Slack alerts.
SLACK_WEBHOOK_URL=
DASHBOARD_URL=
